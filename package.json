{
  "name": "ai-model-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "AI Model Marketplace (AIMM): enterprise blockchain-AI model marketplace. AAI 6850 capstone.",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
